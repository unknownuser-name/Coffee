* text=auto
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.asset text eol=lf
*.unity text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.gif binary
*.dll binary
*.unitypackage binary
# Unity writes empty YAML fields with a trailing space.
*.meta whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
